LAMMPS (2 Apr 2025 - Development - patch_2Apr2025-232-g440e24c60e)
  using 1 OpenMP thread(s) per MPI task
# -------------------- 高速粒子撞击（由 Atomsk 预构建几何） --------------------
# 几何来自：impact_AlCu.lmp（Al 衬底 + Cu 球）

# 1. 初始化和系统设置
units           metal
atom_style      atomic
dimension       3
boundary        p p f       # x/y 周期，z 非周期（固定盒）

# 2. 读取 Atomsk 生成的数据文件
read_data       impact_AlCu.lmp
Reading data file ...
  orthogonal box = (0 0 0) to (162 162 150)
  4 by 5 by 2 MPI processor grid
  reading atoms ...
  130899 atoms
  read_data CPU = 0.468 seconds

# ===== 如果需要，可检查 Masses 是否在数据文件里；若已包含，可删除下面两行 =====
# mass 1 26.9815386         # Al
# mass 2 63.546             # Cu

# 3. 分组（按类型号；若你的 .lmp 中类型号相反，请互换 1/2）
group substrate_group type 1   # 假定 1=Al（衬底）
128000 atoms in group substrate_group
group particle_group  type 2   # 假定 2=Cu（粒子）
2899 atoms in group particle_group

# 3.1 依据衬底实际厚度划分冻结/恒温/可动层（自动从几何计算）
compute zmax_sub substrate_group reduce max z
compute zmin_sub substrate_group reduce min z
run 0                         # 初始化计算以获得 c_* 值
