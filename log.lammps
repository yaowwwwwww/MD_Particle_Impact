LAMMPS (22 Jul 2025 - Development - patch_22Jul2025-72-g8b7fdf9ad3)
KOKKOS mode with Kokkos version 4.6.2 is enabled
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos cuda/aware on
# -------------------- 高速粒子撞击 --------------------
# 模拟铝纳米粒子高速撞击平面fe衬底的过程。

# 1. 初始化和系统设置
units           metal       # 单位制：埃格斯特朗 (A)、皮秒 (ps)、电子伏 (eV)、开尔文 (K)、bar 。
atom_style      atomic      # 标准分子动力学模拟的原子样式
dimension       3           # 3D 模拟
boundary        p p f       # x 和 y 方向周期性边界条件（模拟无限平面），z 方向固定（非周期性）

# 2. 定义尺寸和变量（用于快速测试的纳米尺度）
variable particle_radius equal 10.0    # 粒子半径 (R)，单位埃格斯特朗 (3 纳米)
variable particle_diameter equal ${particle_radius}*2.0 # 30 Å *2=6纳米
variable particle_diameter equal 10*2.0 


# 衬底尺寸基于粒子半径
variable substrate_half_width equal ${particle_radius}*5.0 # 衬底半宽 (L) = 5R = 150 埃 (15 纳米)
variable substrate_half_width equal 10*5.0 
variable substrate_height equal ${particle_radius}*6.0     # 衬底高度 (H) = 6R = 180 埃 (18 纳米)
WARNING: Detected non-ASCII characters in input. Will try to continue by replacing with ASCII equivalents where known. (src/input.cpp:478)
variable substrate_height equal 10*6.0     
variable frozen_layer_height equal ${particle_radius}*2  # 冻结层高度 = 2r = 60 埃 (6 纳米)
variable frozen_layer_height equal 10*2  
variable thermostat_layer_height equal ${particle_radius}*1 # 恒温层厚度30埃 (3 纳米)
variable thermostat_layer_height equal 10*1 
variable thermostat_upper_z equal ${frozen_layer_height}+${thermostat_layer_height} # 新增：恒温层上边界
variable thermostat_upper_z equal 20+${thermostat_layer_height} 
variable thermostat_upper_z equal 20+10 
variable mobile_layer_upper_z equal ${substrate_height} # 可移动层上边界180-60-30=90
variable mobile_layer_upper_z equal 60 


# 粒子初始位置 (z 坐标的中心)
variable particle_center_z equal ${substrate_height} + ${particle_radius} + ${particle_radius}*1
variable particle_center_z equal 60 + ${particle_radius} + ${particle_radius}*1
variable particle_center_z equal 60 + 10 + ${particle_radius}*1
variable particle_center_z equal 60 + 10 + 10*1


# 模拟盒子：需要包含整个系统并允许形变。
variable xlo equal -${substrate_half_width}
variable xlo equal -50
variable xhi equal ${substrate_half_width}
variable xhi equal 50
variable ylo equal -20*2.866
variable yhi equal 20*2.866
variable zlo equal 0.0
variable zhi equal ${particle_center_z} + ${particle_radius}*5 # 1.5R 作为形变缓冲
variable zhi equal 80 + ${particle_radius}*5 
variable zhi equal 80 + 10*5 

region sim_box block ${xlo} ${xhi} ${ylo} ${yhi} ${zlo} ${zhi} units box
region sim_box block -50 ${xhi} ${ylo} ${yhi} ${zlo} ${zhi} units box
region sim_box block -50 50 ${ylo} ${yhi} ${zlo} ${zhi} units box
region sim_box block -50 50 -57.32 ${yhi} ${zlo} ${zhi} units box
region sim_box block -50 50 -57.32 57.32 ${zlo} ${zhi} units box
region sim_box block -50 50 -57.32 57.32 0 ${zhi} units box
region sim_box block -50 50 -57.32 57.32 0 130 units box
create_box 2 sim_box # 创建包含 2 种原子类型的模拟盒子：类型 1 用于粒子铝，类型 2 用于衬底 钢（铁）
Created orthogonal box = (-50 -57.32 0) to (50 57.32 130)
  1 by 1 by 1 MPI processor grid

# 重要：为每种原子类型定义质量
mass 1 26.9815386 # 类型 1 (粒子) 铝的原子质量，单位 amu
mass 2 55.845    # 类型 2 (衬底) 钢（铁）的原子质量，单位 amu

# 3. 创建衬底

lattice bcc 2.866 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
Lattice spacing in x,y,z = 2.866 2.866 2.866
region substrate_region block ${xlo} ${xhi} ${ylo} ${yhi} ${zlo} ${substrate_height} units box
region substrate_region block -50 ${xhi} ${ylo} ${yhi} ${zlo} ${substrate_height} units box
region substrate_region block -50 50 ${ylo} ${yhi} ${zlo} ${substrate_height} units box
region substrate_region block -50 50 -57.32 ${yhi} ${zlo} ${substrate_height} units box
region substrate_region block -50 50 -57.32 57.32 ${zlo} ${substrate_height} units box
region substrate_region block -50 50 -57.32 57.32 0 ${substrate_height} units box
region substrate_region block -50 50 -57.32 57.32 0 60 units box
create_atoms 2 region substrate_region
Created 57960 atoms
  using lattice units in orthogonal box = (-50 -57.32 0) to (50 57.32 130)
  create_atoms CPU = 0.078 seconds

# 创建粒子
lattice fcc 4.05 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
Lattice spacing in x,y,z = 4.05 4.05 4.05
region particle_region sphere 0.0 0.0 ${particle_center_z} ${particle_radius} units box
region particle_region sphere 0.0 0.0 80 ${particle_radius} units box
region particle_region sphere 0.0 0.0 80 10 units box
create_atoms 1 region particle_region
Created 249 atoms
  using lattice units in orthogonal box = (-50 -57.32 0) to (50 57.32 130)
  create_atoms CPU = 0.001 seconds

# 对原子进行分组，以便于操作
group particle_group type 1    # 粒子组包含类型 1 的原子
249 atoms in group particle_group
group substrate_group type 2   # 衬底组包含类型 2 的原子
57960 atoms in group substrate_group

# 定义并冻结衬底的底部层
region frozen_layer block ${xlo} ${xhi} ${ylo} ${yhi} 0.0 ${frozen_layer_height} units box
region frozen_layer block -50 ${xhi} ${ylo} ${yhi} 0.0 ${frozen_layer_height} units box
region frozen_layer block -50 50 ${ylo} ${yhi} 0.0 ${frozen_layer_height} units box
region frozen_layer block -50 50 -57.32 ${yhi} 0.0 ${frozen_layer_height} units box
region frozen_layer block -50 50 -57.32 57.32 0.0 ${frozen_layer_height} units box
region frozen_layer block -50 50 -57.32 57.32 0.0 20 units box
group frozen_atoms region frozen_layer
19320 atoms in group frozen_atoms

# 定义恒温层（在冻结层之上）
region thermostat_layer block ${xlo} ${xhi} ${ylo} ${yhi} ${frozen_layer_height} ${thermostat_upper_z} units box
region thermostat_layer block -50 ${xhi} ${ylo} ${yhi} ${frozen_layer_height} ${thermostat_upper_z} units box
region thermostat_layer block -50 50 ${ylo} ${yhi} ${frozen_layer_height} ${thermostat_upper_z} units box
region thermostat_layer block -50 50 -57.32 ${yhi} ${frozen_layer_height} ${thermostat_upper_z} units box
region thermostat_layer block -50 50 -57.32 57.32 ${frozen_layer_height} ${thermostat_upper_z} units box
region thermostat_layer block -50 50 -57.32 57.32 20 ${thermostat_upper_z} units box
region thermostat_layer block -50 50 -57.32 57.32 20 30 units box
group thermostat_atoms region thermostat_layer
9680 atoms in group thermostat_atoms

# 定义可移动层（在恒温层之上，不包含粒子）
region mobile_layer block ${xlo} ${xhi} ${ylo} ${yhi} ${thermostat_upper_z} ${mobile_layer_upper_z} units box
region mobile_layer block -50 ${xhi} ${ylo} ${yhi} ${thermostat_upper_z} ${mobile_layer_upper_z} units box
region mobile_layer block -50 50 ${ylo} ${yhi} ${thermostat_upper_z} ${mobile_layer_upper_z} units box
region mobile_layer block -50 50 -57.32 ${yhi} ${thermostat_upper_z} ${mobile_layer_upper_z} units box
region mobile_layer block -50 50 -57.32 57.32 ${thermostat_upper_z} ${mobile_layer_upper_z} units box
region mobile_layer block -50 50 -57.32 57.32 30 ${mobile_layer_upper_z} units box
region mobile_layer block -50 50 -57.32 57.32 30 60 units box
group mobile_atoms region mobile_layer
28960 atoms in group mobile_atoms

# 将粒子组和可移动衬底组合成一个用于 NVE 的组
group nve_atoms union particle_group mobile_atoms
29209 atoms in group nve_atoms



# 4. 初始速度
# 为所有可移动原子设置初始温度 (例如 300K)
velocity mobile_atoms create 300.0 12345 mom yes rot yes dist gaussian

# 撞击速度变量
variable impact_vel equal -5 # 500 米/秒 = 5 埃/皮秒 (负值表示沿 -z 方向)


# 5. 原子间势函数 (Hybrid/Overlay)
pair_style hybrid/overlay eam/fs  lj/cut 10
pair_coeff * * eam/fs /home/wuwen123/comp/yao/lammps/potentials/AlFe_mm.eam.fs Al Fe
Reading eam/fs potential file /home/wuwen123/comp/yao/lammps/potentials/AlFe_mm.eam.fs with DATE: 2007-06-11
pair_coeff 1 2 lj/cut 0.0000001 10

velocity particle_group set 0.0 0.0 ${impact_vel} sum yes units box
velocity particle_group set 0.0 0.0 -5 sum yes units box

# 冻结底层
fix 1 frozen_atoms setforce 0.0 0.0 0.0
velocity frozen_atoms set 0 0 0
# 恒温层控温（300K）
fix 2 thermostat_atoms nvt temp 300.0 300.0 0.1

# 粒子和可移动衬底 NVE 积分
fix 3 nve_atoms nve

# ----------- 输出和转储 ------------
thermo_style custom step time temp pe ke etotal press
thermo 200

dump 1 all custom 200 dump.impact.lammpstrj id type x y z vx vy vz

# ----------- 运行模拟 ------------
timestep 0.0001  # 0.1 fs
run 100000        # 5 ps
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
