Total # of neighbors = 0
Ave neighs/atom = 0
Neighbor list builds = 0
Dangerous builds = 0
variable zmin equal c_zmin_sub
variable zmax equal c_zmax_sub

# 你可按需要调整以下厚度（Å）
variable frozen_layer_height     equal 40.0     # 冻结层厚度
variable thermostat_layer_height equal 20.0     # 恒温层厚度
variable thermostat_upper_z      equal ${zmin}+${frozen_layer_height}
variable thermostat_upper_z      equal 0+${frozen_layer_height}
variable thermostat_upper_z      equal 0+40
variable mobile_layer_upper_z    equal ${zmax}
variable mobile_layer_upper_z    equal 78.975

# 区域与分组
region frozen_layer     block INF INF INF INF ${zmin} ${thermostat_upper_z}     units box
region frozen_layer     block INF INF INF INF 0 ${thermostat_upper_z}     units box
region frozen_layer     block INF INF INF INF 0 40     units box
region thermostat_layer block INF INF INF INF ${thermostat_upper_z} \
region thermostat_layer block INF INF INF INF 40 \
