 # sample surface deposition script for atoms

#模型基本参数
units		metal
atom_style      atomic
boundary        p p f
timestep          0.001  #1 fs
neighbor         2.0 bin
neigh_modify   every 1 delay 0 check yes
variable          model_hi   equal 5


#建模
lattice		fcc 3.61
region             box block 0 20 0 20 0 30 units lattice
create_box      3 box

region		substrate block INF INF INF INF INF ${model_hi}  units lattice
create_atoms	1 region substrate

#相互作用势函数
pair_style hybrid lj/cut 10.0  airebo 4.0 eam 
pair_coeff   	1 1  eam     Cu_u3.eam
pair_coeff       2*3 2*3  lj/cut    0.01276  3.81     #C-C
pair_coeff	1 2*3  lj/cut    0.02578 3.0825  #Cu-C
pair_coeff        * *   airebo CH.airebo NULL NULL C   #C2-C2

mass		1  63.5  #Cu
mass               2  12.0  #C1
mass               3  12.0  #C2

group	     addatoms type 2   #addatoms is C1
#group          deposit_re type 3 

variable       mobile_lo equal ${model_hi}-2
region          mobile block  0  20  0  20  ${mobile_lo} INF units lattice
group	      mobile region mobile

#定义C2（沉积）区域
variable        deposit_re_lo equal  5.2 #bound(mobile,zmax)/3.61
variable        deposit_re_up equal ${deposit_re_lo}+1
region          deposit_re block 0 20 0 20 ${deposit_re_lo} ${deposit_re_up} units lattice

compute		add addatoms temp
compute_modify	add dynamic/dof yes extra/dof 0
variable nu_addatoms equal count(addatoms)
variable nu_deposit      equal count(deposit_re)
variable current_step equal step


fix mycount addatoms print 100 "${current_step} ${nu_addatoms} ${nu_deposit}" file addatoms_count.txt


fix		1 addatoms nvt temp 500 500 0.1
fix		2 mobile langevin 500  500   0.1 587283
fix		3 mobile nve

region     slab block 0 20 0 20 10 20 units lattice
fix		4 addatoms deposit 100 2 100 12345 region slab near 1.0 &
                vz -1.0 -1.0
fix		5 addatoms wall/reflect zhi EDGE

region          C1_re  block 0 20 0 20 ${deposit_re_up} INF units lattice
group           deposit_re dynamic addatoms region deposit_re every 10
group           C1_atom    dynamic addatoms region C1_re every 10
#fix_modify 1 dynamic full

thermo_style	custom step atoms temp epair etotal press
thermo          100
thermo_modify	temp add

#dump		1 all atom 50 dump/dump.deposit.atom
dump    1      all                custom 100 dump/deposit.* id type x y z vx vy vz
dump     2    deposit_re   custom 100 dump_file.dat id type x y z


#dump		2 all image 50 image.*.jpg type type &
#		axes yes 0.8 0.02 view 80 -30
#dump_modify	2 pad 5

#dump		3 all movie 50 movie.mpg type type &
#		axes yes 0.8 0.02 view 80 -30
#dump_modify	3 pad 5

run             10000  every 100 "set group deposit_re type 3" &
						"set group C1_atom    type 2" &
                                                "print 'nu_deposit = ${nu_deposit}'"&
						"print 'deposit_re_lo = ${deposit_re_lo}'"