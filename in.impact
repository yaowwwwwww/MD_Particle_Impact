# -------------------- LAMMPS 输入脚本：高速粒子撞击（分子动力学尺度） --------------------
# 模拟铝纳米粒子高速撞击平面fe衬底的过程。

# 1. 初始化和系统设置
units           metal       # 单位制：埃格斯特朗 (A)、皮秒 (ps)、电子伏 (eV)、开尔文 (K)、大气压 (atm) 等。
atom_style      atomic      # 标准分子动力学模拟的原子样式
dimension       3           # 3D 模拟
boundary        p p s       # x 和 y 方向周期性边界条件（模拟无限平面），z 方向固定（非周期性）

# 2. 定义尺寸和变量（用于快速测试的纳米尺度）
variable particle_radius equal 30.0    # 粒子半径 (R)，单位埃格斯特朗 (1 纳米)
variable particle_diameter equal ${particle_radius}*2.0 # 5 纳米

 
# 衬底尺寸基于粒子半径
variable substrate_half_width equal ${particle_radius}*5.0 # 衬底半宽 (L) = 2R = 50 埃 (5 纳米)
variable substrate_height equal ${particle_radius}*6.0     # 衬底高度 (H) = 2R = 50 埃 (5 纳米)
variable frozen_layer_height equal ${particle_radius}*3  # 冻结层高度 = x *R = 
variable thermostat_layer_height equal ${particle_radius}*2 # 新增：恒温层厚度
variable thermostat_upper_z equal ${frozen_layer_height}+${thermostat_layer_height} # 新增：恒温层上边界
variable mobile_layer_upper_z equal ${substrate_height} # 新增：可移动层上边界
# 定义衬底固定的中心点z坐标
variable center_z equal ${frozen_layer_height}+0.1

# 粒子初始位置 (z 坐标的中心)
# 粒子的底部表面将位于衬底的顶部表面。
# 衬底顶部在 z = ${substrate_height} 2.5 埃的初始距离
variable particle_center_z equal ${substrate_height} + ${particle_radius} + ${particle_radius}*1


# 模拟盒子：需要包含整个系统并允许形变。
variable xlo equal -${substrate_half_width}
variable xhi equal ${substrate_half_width}
variable ylo equal -0.5
variable yhi equal 0.5
variable zlo equal 0.0
variable zhi equal ${particle_center_z} + ${particle_radius}*20 # 1.5R 作为形变缓冲

region sim_box block ${xlo} ${xhi} ${ylo} ${yhi} ${zlo} ${zhi} units box
create_box 2 sim_box # 创建包含 2 种原子类型的模拟盒子：类型 1 用于粒子铝，类型 2 用于衬底 钢（铁）

# 重要：为每种原子类型定义质量
mass 1 26.9815386 # 类型 1 (粒子) 铝的原子质量，单位 amu
mass 2 55.845    # 类型 2 (衬底) 钢（铁）的原子质量，单位 amu

# 3. 创建原子：衬底和粒子 

lattice bcc 2.866 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region substrate_region block ${xlo} ${xhi} ${ylo} ${yhi} ${zlo} ${substrate_height} units box
create_atoms 2 region substrate_region

lattice fcc 4.05 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region particle_region sphere 0.0 0.0 ${particle_center_z} ${particle_radius} units box
create_atoms 1 region particle_region

# 对原子进行分组，以便于操作
group particle_group type 1    # 粒子组包含类型 1 的原子
group substrate_group type 2   # 衬底组包含类型 2 的原子

# 定义并冻结衬底的底部层
region frozen_layer block ${xlo} ${xhi} ${ylo} ${yhi} 0.0 ${frozen_layer_height} units box
group frozen_atoms region frozen_layer

# 定义恒温层（在冻结层之上）
region thermostat_layer block ${xlo} ${xhi} ${ylo} ${yhi} ${frozen_layer_height} ${thermostat_upper_z} units box
group thermostat_atoms region thermostat_layer

# 定义可移动层（在恒温层之上，不包含粒子）
region mobile_layer block ${xlo} ${xhi} ${ylo} ${yhi} ${thermostat_upper_z} ${mobile_layer_upper_z} units box
group mobile_atoms region mobile_layer

# 将粒子组和可移动衬底组合成一个用于 NVE 的组
group nve_atoms union particle_group mobile_atoms

# 定义一个位于衬底中心的球形区域，用于固定
# 半径 5.0 埃足以包含几个原子，起到锚定作用
 region center_point sphere 0.0 0.0 ${center_z} 5.0 units box
 group center_atoms region center_point

# 将中心点原子从可移动层、恒温层和NVE组中移除
group mobile_atoms subtract mobile_atoms center_atoms
group thermostat_atoms subtract thermostat_atoms center_atoms
group nve_atoms subtract nve_atoms center_atoms

# 4. 初始速度
# 为所有可移动原子设置初始温度 (例如 300K)
velocity mobile_atoms create 300.0 12345 dist gaussian

# 给粒子组施加撞击速度
variable impact_vel equal -5 # 500 米/秒 = 5 埃/皮秒 (负值表示沿 -z 方向)
# !!! 新增：在施加撞击速度前，先移除粒子组的热速度，确保稳定性。
velocity particle_group set 0.0 0.0 0.0 units box
velocity particle_group set 0.0 0.0 ${impact_vel} units box
 

# 5. 原子间势函数 (Hybrid/Overlay)
# 重新配置为 EAM + LJ 混合势

# 定义 LJ 势的参数 (这些变量已经存在于您的脚本开头，这里是再次引用)
variable lj_epsilon equal 0 # eV, 强度
variable lj_sigma equal 2.5   # Angstrom, 范围
 
# 使用 hybrid/overlay 势能
# lj/cut 2.5 表示 LJ 势的截断半径为 2.5 埃。
pair_style hybrid/overlay eam/fs lj/cut 2.5

# EAM 势函数的参数设置
# pair_coeff 命令的顺序必须与 pair_style 中的势能类型顺序一致。
# 这里的"*"表示所有原子，后面的"Al Fe"表示势能文件中的原子类型顺序。
pair_coeff * * eam/fs /home/wuwen/lammps/potentials/AlFe_mm.eam.fs Al Fe

# LJ 势函数的参数设置
# ！！！已修改：LJ势只作用于不同原子类型（Al-Fe）之间！！！
# 对于同种原子对（Al-Al和Fe-Fe），将LJ势的epsilon参数设置为0，使其不起作用。
pair_coeff 1 1 lj/cut 0.0 0.0  # Al-Al 之间没有 LJ 势
pair_coeff 1 2 lj/cut ${lj_epsilon} ${lj_sigma} # Al-Fe 之间有 LJ 势
pair_coeff 2 2 lj/cut 0.0 0.0  # Fe-Fe 之间没有 LJ 势

# 6. 模拟设置
# !!! 已修改：时间步长减小到 0.0001 ps，以提高稳定性 !!!
timestep 0.0001        # 时间步长，单位皮秒。对于高速模拟和稳定性至关重要。
comm_modify vel yes   # 确保速度被正确通信，以进行准确的力计算

# 8. 输出和分析
# 标准热力学输出
compute KE_all all ke     # 计算所有原子的动能
compute PE_all all pe     # 计算所有原子的势能
# 总能量 (etotal) 将由 thermo_style 直接计算和输出

# !!! 为保持相同的模拟时间间隔而更新了输出频率 !!!
thermo_style custom step dt time temp etotal ke pe press vol density # 定义热力学输出样式
thermo 200 # 每 200 步输出一次热力学数据

# 转储原子位置用于可视化 (e.g., OVITO)
# !!! 为保持相同的模拟时间间隔而更新了输出频率 !!!
dump 1 all custom 200 dump.impact.lammpstrj id type x y z vx vy vz # 每 200 步转储一次原子数据
# dump_modify 1 image full center yes box yes adiam 1.5 # dump 修改：输出完整图像，居中，显示盒子，原子放大 1.5 倍以便更好可视化


# -------------------- 阶段 1: NPT 平衡 --------------------
# 平衡前的准备：只对衬底的可移动部分创建初始速度
# -velocity mobile_atoms create 300.0 12345 dist gaussian
#velocity thermostat_atoms create 300.0 12345 dist gaussian
# -velocity particle_group set 0.0 0.0 0.0 # 粒子在平衡阶段不应该有速度

# NPT 阶段的 fix 命令
# 使用 fix 1 进行 NPT 平衡，将整个系统保持在 300K 和 0 压强
# -fix 1 mobile_atoms npt temp 300.0 300.0 100.0 x 0.0 0.0 1000.0 y 0.0 0.0 1000.0
# -fix 2 frozen_atoms setforce 0.0 0.0 0.0
fix 3 center_atoms setforce 0.0 0.0 0.0
# 这里我们对恒温层使用 NVT，因为我们希望在撞击过程中维持其温度，而不是压强。
# 但为了平衡，我们也可以先对它进行 NPT，不过只对 mobile_atoms 进行 NPT 也是一个合理的选择。
# 让我们先对mobile_atoms进行NPT，同时对恒温层进行NVT来平衡温度。
fix 8 thermostat_atoms nvt temp 300.0 300.0 100.0

# 运行 10,000 步进行平衡
run 10000

# 平衡结束后，移除 NPT 约束
unfix 1
unfix 2
unfix 3
unfix 8
# --------------------------------------------------------


# -------------------- 阶段 2: NVE 撞击模拟 --------------------

# 撞击前的准备
# 重置粒子和衬底可移动部分的速度为 0，然后施加撞击速度
velocity nve_atoms set 0.0 0.0 0.0 units box
velocity particle_group set 0.0 0.0 ${impact_vel} units box

# 撞击阶段的 fix 命令
fix 4 nve_atoms nve
fix 5 frozen_atoms setforce 0.0 0.0 0.0
fix 6 thermostat_atoms nvt temp 300.0 300.0 100.0
fix 7 center_atoms setforce 0.0 0.0 0.0 # 冻结中心点原子，防止漂移

# 运行撞击模拟
run 50000

# 撞击结束后，移除所有 fix
unfix 4
unfix 5
unfix 6
unfix 7
# --------------------------------------------------------


# 9. 可选：写入重启文件
write_restart restart.impact
