units           metal
atom_style      atomic
dimension       3
boundary        p p p      
neighbor        1.5 bin        
neigh_modify    delay 5

########### Atomsk data###########
read_data       impact_AlCu.lmp
############        ##########

group substrate_group type 1   #  1=Al（衬底）
group particle_group  type 2   #  2=Cu（粒子）

variable T equal 300

pair_style  eam/alloy
pair_coeff  * * /home/wuwen123/comp/yao/lammps/potentials/AlCu.eam.alloy  Al  Cu

timestep        0.0005

change_box all boundary p p s

dump 1 all custom 500 relax.xyz id mass type x y z

minimize 1.0e-12 1.0e-12 1000 1000

write_data AlCu.relaxedmodel

velocity all create 300.0 4928459

thermo_style custom step temp pxx pyy pzz press vol     ##print the component of thermal
thermo 1000
fix 1 all npt temp $T $T 0.5 x 0.0 0.0 0.12 y 0.0 0.0 0.12 drag 2

compute myP all pressure thermo_temp
fix aveP all ave/time 100 50 5000 c_myP[1] c_myP[2] file press_xy.avg        ##average press.

run 50000
unfix 1

# # # # # # #   frozen_layer  # # # # # # # # 
variable frozen_layer_thick equal 10  #  frozen_layer
region frozen_layer block INF INF INF INF 0.0 ${frozen_layer_thick} units box
group frozen_atoms region frozen_layer
fix freeze frozen_atoms setforce 0.0 0.0 0.0
velocity frozen_atoms set 0.0 0.0 0.0
# # # # # # #  # # # # # # #  # # # # # # #  # # # # # # #  

# # # # # # #  
velocity particle_group set 0.0 0.0 -5 sum yes units box

group mobile_all subtract all frozen_atoms
fix integ mobile_all nve

thermo 1000

dump 2 all custom 200 impact_1.lammpstrj id type x y z vx vy vz

run 50000